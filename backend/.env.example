CTJ_API_PREFIX=/api
CTJ_FRONTEND_ORIGIN=http://localhost:3000
# Optional override; default is repo-root data directory.
# CTJ_DATA_DIR=../data

# Supabase (required for /api/alerts/feed)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
# Optional
# SUPABASE_SCHEMA=public

# Chart generation throttling / cache
# CTJ_CHART_FETCH_MIN_INTERVAL_SECONDS=0.8
# CTJ_CHART_OHLC_CACHE_TTL_SECONDS=900
# CTJ_MAX_NEW_CHARTS_PER_FEED_REQUEST=3
